---
import { Image } from 'astro:assets';

import img from '../assets/images/programa-pilar.webp';
---

<section class="w-full py-20">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            <div>
                <Image src={img} width="900" height="900" alt="Programa Pilar" class="rounded-lg max-w-lg aspect-square" />
            </div>
            
            <div>
                <h2 class="text-4xl lg:text-3xl font-medium tracking-tighter text-secondary-600 mb-6">
                    Programa <span class="text-primary-600">Pilar</span>
                </h2>
                
                <p class="text-primary-900 leading-relaxed mb-6">
                   Uma solução corporativa para o desenvolvimento de mulheres na liderança e o fortalecimento das relações organizacionais.            
                </p>

                <a href="https://signabranding.com.br/pilar/" target="_blank" class="bg-primary-600 text-white px-6 py-2 rounded text-center  font-medium hover:bg-primary-700 transition">Saiba mais</a>
            </div>
        </div>
    </section>
</section>