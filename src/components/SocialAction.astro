---
import { HeartHandshake, MapPinned, Megaphone, ClipboardList } from 'lucide-astro';


const services = [
  {
    title: "Promoção de saúde integral, atenção e cuidado a mulheres, crianças, famílias e comunidades",
    description: "",
    icon: HeartHandshake,
  },
  {
    title: "Articulação intersetorial com saúde, assistência social e educação, com presença territorial longitudinal",
    description: "",
    icon: MapPinned,
  },
  {
    title: "Educação popular, comunicação comunitária, fortalecimento de vínculos e emancipação",
    description: "",
    icon: Megaphone,
  },
  {
    title: " Produção de diagnósticos comunitários para conquista de direitos e políticas públicas",
    description: "",
    icon: ClipboardList,
  },
];
---

<section id="transformacao-social" class="w-full bg-tertiary-50">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <div class="lg:sticky lg:top-32 lg:self-start pr-16">
          <h2 class="text-4xl lg:text-4xl font-medium tracking-tighter text-secondary-600 mb-6">
              Transformação&nbsp;
              <span class="text-primary-600">Social</span>
          </h2>
          <p class="text-lg text-primary-900 leading-relaxed">
              Mobilizamos recursos de múltiplas fontes para desenvolver ações e relações de impacto, fortalecendo a nossa sustentabilidade.
          </p>
        </div>

        <div class="space-y-12">
        {services.map(service => (
            <div class="">
              <div class="bg-tertiary-300 p-2 rounded-full w-12 h-12 flex items-center justify-center mb-5">
                <service.icon class="w-6 h-6 text-primary-900" />
              </div>
                <h3 class="text-lg tracking-tighter text-primary-900 mb-3">
                    {service.title}
                </h3>
                <p class="text-primary-900 mb-4">
                    {service.description}
                </p>
            </div>
        ))}
        </div>
    </div>
    </section>
</section>