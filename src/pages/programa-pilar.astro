---
import "../styles/programa-pilar.css";
---

<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Programa Pilar — Instituto Elaborar &amp; Signà Branding</title>
<meta name="description" content="Programa Pilar: desenvolvimento de mulheres na liderança e fortalecimento das relações organizacionais, uma parceria entre Instituto Elaborar e Signà Branding.">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

</head>
<body>

<svg style="display:none" aria-hidden="true">
<defs>
<symbol id="ic-badge" viewBox="0 0 24 24"><circle cx="12" cy="9" r="5"/><path d="M8.5 13.5L7 21l5-2.5 5 2.5-1.5-7.5"/></symbol>
<symbol id="ic-weight" viewBox="0 0 24 24"><circle cx="4" cy="12" r="2.3"/><circle cx="20" cy="12" r="2.3"/><line x1="6.3" y1="12" x2="17.7" y2="12"/><line x1="8.2" y1="8.7" x2="8.2" y2="15.3"/><line x1="15.8" y1="8.7" x2="15.8" y2="15.3"/></symbol>
<symbol id="ic-door" viewBox="0 0 24 24"><rect x="5" y="2.5" width="12" height="19"/><circle cx="14" cy="12" r="0.8" fill="currentColor" stroke="none"/><line x1="2" y1="21.5" x2="20" y2="21.5"/></symbol>
<symbol id="ic-speech" viewBox="0 0 24 24"><path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H9l-4.5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/><circle cx="8.5" cy="10.5" r="0.6" fill="currentColor" stroke="none"/><circle cx="12" cy="10.5" r="0.6" fill="currentColor" stroke="none"/><circle cx="15.5" cy="10.5" r="0.6" fill="currentColor" stroke="none"/></symbol>
<symbol id="ic-cycle" viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 13.7-5.7L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.7 5.7L4 16"/><path d="M4 20v-4h4"/></symbol>
<symbol id="ic-institution" viewBox="0 0 24 24"><path d="M12 2l10 6H2z"/><line x1="4" y1="10" x2="4" y2="19"/><line x1="9" y1="10" x2="9" y2="19"/><line x1="15" y1="10" x2="15" y2="19"/><line x1="20" y1="10" x2="20" y2="19"/><line x1="2" y1="21" x2="22" y2="21"/></symbol>
<symbol id="ic-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
