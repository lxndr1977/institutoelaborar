<symbol id="ic-megaphone" viewBox="0 0 24 24"><path d="M3 10v4h3l6 4V6L6 10H3z"/><path d="M14 9a4 4 0 0 1 0 6"/><path d="M17 6a8 8 0 0 1 0 12"/></symbol>
<symbol id="ic-leaf" viewBox="0 0 24 24"><path d="M20 4C10 4 4 10 4 18v2h2c8 0 14-6 14-16z"/><path d="M6 18C10 14 14 10 18 6"/></symbol>
<symbol id="ic-trend" viewBox="0 0 24 24"><polyline points="3,17 9,11 13,15 21,7"/><polyline points="15,7 21,7 21,13"/></symbol>
<symbol id="ic-seedling" viewBox="0 0 24 24"><path d="M12 21V11"/><path d="M12 11C12 11 5 11 5 4C12 4 12 11 12 11z"/><path d="M12 14C12 14 19 14 19 8C13 8 12 14 12 14z"/></symbol>
<symbol id="ic-flag" viewBox="0 0 24 24"><line x1="5" y1="3" x2="5" y2="21"/><path d="M5 4.5l14 3.8L5 12z"/></symbol>
<symbol id="ic-magnifier" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><line x1="15.5" y1="15.5" x2="21" y2="21"/></symbol>
<symbol id="ic-column" viewBox="0 0 24 24"><line x1="4" y1="3" x2="20" y2="3"/><line x1="4" y1="21" x2="20" y2="21"/><line x1="7" y1="6" x2="7" y2="18"/><line x1="12" y1="6" x2="12" y2="18"/><line x1="17" y1="6" x2="17" y2="18"/></symbol>
<symbol id="ic-graduation" viewBox="0 0 24 24"><path d="M2 8l10-5 10 5-10 5z"/><path d="M6 10.5v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/><line x1="22" y1="8" x2="22" y2="14"/></symbol>
<symbol id="ic-person" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></symbol>
